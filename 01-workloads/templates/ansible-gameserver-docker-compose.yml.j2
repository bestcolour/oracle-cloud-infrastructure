networks:
  pterodactyl_nw:
    driver: bridge
    ipam:
      config:
        - subnet: 172.20.0.0/16

services:
  database:
    image: mariadb:10.11
    restart: always
    volumes:
      - /srv/pterodactyl/db:/var/lib/mysql
    environment:
      MYSQL_ROOT_PASSWORD: "{{ gameserver_panel_db_password }}"
      MYSQL_DATABASE: "panel"
      MYSQL_USER: "pterodactyl"
      MYSQL_PASSWORD: "{{ gameserver_panel_db_password }}"
    command: --innodb-file-per-table=1 --lower-case-table-names=1
    networks:
      - pterodactyl_nw

  cache:
    image: redis:7-alpine
    restart: always
    networks:
      - pterodactyl_nw

  panel:
    image: ghcr.io/pterodactyl/panel:latest
    restart: always
    links:
      - database
      - cache
    volumes:
      - /srv/pterodactyl/nginx/:/etc/nginx/http.d/
      - /srv/pterodactyl/var/:/var/log/panel/logs
      - /srv/pterodactyl/skip-ssl.cnf:/etc/my.cnf.d/skip-ssl.cnf:ro
    environment:
      APP_ENV: "production"
      APP_ENVIRONMENT_ONLY: "false"
      APP_URL: "https://{{ gameserver_duckdns_domain_name }}.duckdns.org"
      APP_KEY: "{{ gameserver_panel_app_key }}"
      APP_TIMEZONE: "UTC"
      DB_HOST: "database"
      DB_PORT: 3306
      DB_DATABASE: "panel"
      DB_USERNAME: "pterodactyl"
      DB_PASSWORD: "{{ gameserver_panel_db_password }}"
      DB_SSLMODE: "DISABLED"
      CACHE_DRIVER: "redis"
      SESSION_DRIVER: "redis"
      QUEUE_CONNECTION: "redis"
      REDIS_HOST: "cache"
    networks:
      - pterodactyl_nw
    depends_on:
      - database
      - cache

  caddy:
    image: caddy:2-alpine
    restart: always
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /srv/pterodactyl/caddy_data:/data
      - /srv/pterodactyl/caddy_config:/config
    environment:
      DOMAIN: "{{ gameserver_duckdns_domain_name }}.duckdns.org"
    command: caddy reverse-proxy --from "{{ gameserver_duckdns_domain_name }}.duckdns.org" --to panel:80
    networks:
      - pterodactyl_nw
    depends_on:
      - panel